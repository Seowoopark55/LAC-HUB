{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/game", "destination": "/index.html" },
    { "source": "/game/(.*)", "destination": "/index.html" },
    { "source": "/build", "destination": "/index.html" },
    { "source": "/build/(.*)", "destination": "/index.html" },
    { "source": "/cook", "destination": "/index.html" },
    { "source": "/cook/(.*)", "destination": "/index.html" },
    { "source": "/company", "destination": "/index.html" },
    { "source": "/company/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/notices", "destination": "/index.html" },
    { "source": "/notices/(.*)", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/support/(.*)", "destination": "/index.html" }
  ]
}
